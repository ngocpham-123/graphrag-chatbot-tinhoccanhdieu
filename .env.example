# OpenAI / ChatGPT
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Ontotext GraphDB
GRAPHDB_URL=http://localhost:7200
GRAPHDB_REPOSITORY=your_repo_name

# GraphDB authentication (optional — omit if no auth is configured)
GRAPHDB_USERNAME=admin
GRAPHDB_PASSWORD=your_password_here

# Directory containing figure images referenced by hasFigurePath
FIGURES_DIR=asset

# Langfuse tracing (optional — leave the keys empty to disable tracing entirely).
# Get the keys from your Langfuse project settings.
#   running uvicorn on the host  -> http://localhost:3000
#   running via docker-compose   -> http://host.docker.internal:3000
# "localhost" inside a container means the container itself, so it can never
# reach Langfuse published on the host; docker-compose.yml defines the
# host.docker.internal alias for that case.
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxxxxxxxxxx
LANGFUSE_HOST=http://localhost:3000
